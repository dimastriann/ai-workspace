# =============================================================================
# AI Workspace — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ── LLM Provider ─────────────────────────────────────────────────────────────
# OpenAI (primary)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Local LLM (optional — set LLM_PROVIDER=ollama to use)
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_workspace

# ── Redis (optional — cache/rate-limit only) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Vector Database (Qdrant) ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Rust Parser Service ──────────────────────────────────────────────────────
PARSER_SERVICE_URL=http://localhost:8080

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# ── Authentication ───────────────────────────────────────────────────────────
# Bootstrap the first admin on startup (leave empty to skip).
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# ── Web (Next.js) ────────────────────────────────────────────────────────────
# Server-side base URL used by the BFF route handlers.
API_BASE_URL=http://localhost:8000
