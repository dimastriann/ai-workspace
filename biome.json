{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/web/**/*.ts",
      "apps/web/**/*.tsx",
      "apps/web/**/*.js",
      "apps/web/**/*.mjs",
      "apps/web/**/*.jsx",
      "apps/web/**/*.json",
      "apps/web/**/*.css",
      "apps/web-next/**/*.ts",
      "apps/web-next/**/*.tsx",
      "apps/web-next/**/*.js",
      "apps/web-next/**/*.mjs",
      "apps/web-next/**/*.jsx",
      "apps/web-next/**/*.json",
      "apps/web-next/**/*.css",
      "*.js",
      "*.mjs",
      "*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
